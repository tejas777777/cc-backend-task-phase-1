server {
    listen 443 ssl;
    server_name <20.198.123.206>;

    ssl_certificate     /etc/nginx/ssl/thinkit.crt;
    ssl_certificate_key /etc/nginx/ssl/thinkit.key;

    location /static/ {
        alias /home/azureuser/cc-backend-task-phase-1/thinkit_phase2/thinkit/staticfiles/;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
